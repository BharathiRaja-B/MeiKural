# Matching threshold used for near matches (range 0-100; default 80).
NEAR_THRESHOLD=80
CHARACTER_WEIGHT=0.7
WORD_OVERLAP_WEIGHT=0.3
MIN_STANDALONE_TAMIL_WORDS=4

# Optional source overrides. The default primary API is tried first; if it is
# unavailable, the configured bulk API is used as the second independent source.
SOURCE_A_VERSES_URL=https://raw.githubusercontent.com/tk120404/thirukkural/master/thirukkural.json
SOURCE_A_DETAIL_URL=https://raw.githubusercontent.com/tk120404/thirukkural/master/detail.json
SOURCE_B_PRIMARY_URL=https://api-thirukkural.vercel.app/api?num={id}
SOURCE_B_FALLBACK_URL=https://thirukkural.senkanthal.org/kural
SOURCE_TIMEOUT_SECONDS=20
